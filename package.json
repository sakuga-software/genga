{
  "name": "genga-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -F genga-example-react-router dev",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:pack": "node scripts/test-pack.mjs",
    "test:e2e": "node examples/next/e2e/run.mjs",
    "test:e2e:admin": "node examples/react-router/e2e/run.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@12.15.0"
}
