# Postgres URL. Without it, the CMS is off and /admin answers 503.
DATABASE_URL=postgres://genga:genga@localhost:54329/genga
# Public origin of the site.
SITE_URL=http://localhost:5173
# Directory of the uploaded media.
GENGA_MEDIA_DIR=./data/media
# Email of the first admin, filled in the setup form.
GENGA_ADMIN_EMAIL=admin@example.com
